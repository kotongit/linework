<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>Linework</AssemblyName>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>
    <RootNamespace>Linework.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources/Fonts/*.ttf" />
    <None Include="Resources/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources/Models/yolox_nano.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSES/**" Link="Licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources/Sounds/*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <Using Include="System.IO" />
    <ProjectReference Include="../Linework.Core/Linework.Core.csproj" />
  </ItemGroup>
</Project>
