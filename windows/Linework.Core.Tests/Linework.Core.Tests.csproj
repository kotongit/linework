<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Linework.Core/Linework.Core.csproj" />
    <Using Include="Xunit" />
    <Using Include="Linework.Core" />
    <!-- The stores have no WPF in them, so their rules run here without spending Windows minutes. -->
    <Compile Include="../Linework.App/Library/ObservableObject.cs;../Linework.App/Library/ILibraryHost.cs;../Linework.App/Library/Settings.cs;../Linework.App/Library/LibraryLocation.cs;../Linework.App/Library/LibraryStore.cs;../Linework.App/Library/AppModel.cs;../Linework.App/Debug/StoreChecks.cs" LinkBase="AppShared" />
  </ItemGroup>
</Project>
